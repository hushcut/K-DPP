# deploy/.env 로 복사해 채웁니다(Git 에 올리지 않음). 자세한 절차는 README.md.
#   cp .env.example .env && chmod 600 .env

# 접속 주소. DNS A 레코드가 이 서버의 공인 IP 를 가리켜야 Caddy 가 인증서를 받습니다.
# 맥 리허설은 localhost(Caddy 자체 인증서).
K_DPP_DOMAIN=example.com

# DB 비밀번호. 접속 URL 에 그대로 들어가므로 영문·숫자만 씁니다.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# 서버 전체 하루 사진 분석 상한(한국 자정에 0 부터). 한 계정 하루 20번과 따로, 계정 수와 상관없이
# Vision 청구의 최악값을 묶습니다. 100 이면 월 최악 약 $16.5(스캔 1번 = Vision 최대 4건, 월 무료
# 1,000건 뒤 1,000건당 $1.50). 바꾸면 docker compose up -d --wait 로 app 을 다시 띄웁니다.
K_DPP_SCAN_DAILY_MAX=100

# Google Vision 서비스 계정 키 파일(이 폴더 기준 경로). 권한은 README 'Vision 키'.
K_DPP_VISION_KEY_FILE=./secrets/vision_key.json

# 카카오 로그인: 카카오 개발자 콘솔의 앱 ID(숫자, 비밀값 아님). 비우면 카카오 로그인이 꺼집니다(503).
K_DPP_KAKAO_APP_ID=

# 매일 백업 시각(KST, 기본 04:00). Lightsail 자동 스냅샷과 겹치지 않게 둡니다.
#K_DPP_BACKUP_AT=04:00

# 맥 리허설에서만 주석을 풉니다(이 맥 안에서만, 80·443 대신 8080·8443).
#K_DPP_LISTEN_ADDR=127.0.0.1
#K_DPP_HTTP_PORT=8080
#K_DPP_HTTPS_PORT=8443
