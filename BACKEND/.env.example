# Copy this file to .env for local-only settings if needed.
# The current backend can run without a .env file.

# PostgreSQL only. Default (when unset) is the local DB from compose.yaml
# (`docker compose up -d --wait`, then `alembic upgrade head`).
K_DPP_DATABASE_URL=postgresql+psycopg://kdpp:kdpp@127.0.0.1:5432/k_dpp

# Local FastAPI server settings used in README examples.
K_DPP_HOST=0.0.0.0
K_DPP_PORT=8000

# Browser origins allowed by CORS, comma separated (e.g. Flutter web started with
# `flutter run -d chrome --web-port 5000` -> http://localhost:5000).
# Empty = no browser origin is allowed. The mobile app does not need CORS.
K_DPP_CORS_ORIGINS=

# API docs (/docs, /redoc, /openapi.json). Empty or on = shown (local default).
# The deploy server sets off. Any value other than on/off/true/false/1/0 stops startup.
K_DPP_API_DOCS=

# Email verification codes (signup, password reset). Empty or log = no mail is sent;
# the code is printed to the server log (local, CI, demo). Any other value stops
# startup: a real mail service is added only after the sending domain is verified.
K_DPP_EMAIL_DELIVERY=
# Server-wide daily cap on accepted code requests (UTC day). Empty = no cap.
# Over the cap, POST /auth/email-code returns 503 EMAIL_SEND_UNAVAILABLE.
K_DPP_EMAIL_DAILY_MAX=

# Kakao login (POST /auth/kakao): the app ID from the Kakao developers console
# (a number, not a secret). Empty = Kakao login is off (503 SOCIAL_LOGIN_UNAVAILABLE,
# local and CI default). Not a number = startup stops. No Kakao secret is kept here.
K_DPP_KAKAO_APP_ID=

# Google Vision service account file for AI/OCR.
# Do not commit the real key.json file.
GOOGLE_APPLICATION_CREDENTIALS=../AI/kdpp_ai_ocr_integrated/key.json

# Server-wide daily cap on scans that call Google Vision (resets at midnight KST).
# Empty = no server-wide cap (local default). The deploy server must set it.
# Each account is also capped at 20 Vision scans a day. Any value other than a
# positive integer stops startup.
K_DPP_SCAN_DAILY_MAX=
